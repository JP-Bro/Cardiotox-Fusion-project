# Cardiotox-Fusion Git Ignore Rules

# Python caches
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ipynb_checkpoints/

# Virtual environments
venv/
.venv/
env/

# IDE configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Large raw GCTX binary matrix (>100MB exceeds standard GitHub push limit)
data/raw/lincs/*.gctx
*.gctx

# Large trained checkpoints (PT / PKL)
models/checkpoints/*.pt
models/checkpoints/*.pkl

# OS files
Thumbs.db
ehthumbs.db
Desktop.ini
